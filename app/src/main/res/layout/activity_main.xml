<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090B"
    tools:context=".MainActivity">

    <com.pedro.rtplibrary.view.OpenGlView
        android:id="@+id/openglview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:keepAspectRatio="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#9909090B" />

    <ImageButton
        android:id="@+id/settings_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:background="#1B1B22"
        android:src="@drawable/ic_settings"
        android:contentDescription="Settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#F5F5F7" />

    <LinearLayout
        android:id="@+id/top_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="72dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#111218"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/stream_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OBS Studio Ready"
            android:textColor="#F5F5F7"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scene_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Scene preset • Prime Black"
            android:textColor="#A3A8B3"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#111218"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/action_row">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Scene Builder"
                android:textColor="#F5F5F7"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/vertical_crop_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9:16"
                android:textColor="#F5F5F7" />
        </LinearLayout>

        <EditText
            android:id="@+id/scene_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Scene preset name"
            android:textColor="#F5F5F7"
            android:textColorHint="#7A808D"
            android:backgroundTint="#2F313B"
            android:singleLine="true" />

        <EditText
            android:id="@+id/overlay_text_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Overlay text"
            android:textColor="#F5F5F7"
            android:textColorHint="#7A808D"
            android:backgroundTint="#2F313B"
            android:singleLine="true" />

        <EditText
            android:id="@+id/browser_url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Browser widget URL"
            android:textColor="#F5F5F7"
            android:textColorHint="#7A808D"
            android:backgroundTint="#2F313B"
            android:singleLine="true" />

        <Button
            android:id="@+id/save_scene_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Save scene preset" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Private chat (local only)"
            android:textColor="#F5F5F7"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/private_chat_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Type a private reply"
            android:textColor="#F5F5F7"
            android:textColorHint="#7A808D"
            android:backgroundTint="#2F313B"
            android:singleLine="true"
            android:imeOptions="actionSend" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/private_chat_send_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Send private reply" />
        </LinearLayout>

        <TextView
            android:id="@+id/private_chat_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="6"
            android:text="No private replies yet"
            android:textColor="#A3A8B3"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Live audience counter"
            android:textColor="#F5F5F7"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/audience_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Audience: 0"
            android:textColor="#5EEAD4"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/audience_minus_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-1" />

            <Button
                android:id="@+id/audience_plus_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="+1" />
        </LinearLayout>

        <Button
            android:id="@+id/audience_reset_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Reset audience" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Subscriber counter"
            android:textColor="#F5F5F7"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subscriber_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Subscribers: 0"
            android:textColor="#F59E0B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/subscriber_minus_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-1" />

            <Button
                android:id="@+id/subscriber_plus_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="+1" />
        </LinearLayout>

        <Button
            android:id="@+id/subscriber_reset_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Reset subscribers" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/action_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/start_stop_stream"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/button_start_stream" />

            <Button
                android:id="@+id/start_stop_record"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Record" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/save_30s"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="30s" />

            <Button
                android:id="@+id/save_60s"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="60s" />

            <Button
                android:id="@+id/save_90s"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="90s" />

            <Button
                android:id="@+id/save_120s"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="120s" />
        </LinearLayout>
    </LinearLayout>

    <WebView
        android:id="@+id/webview_widget"
        android:layout_width="220dp"
        android:layout_height="140dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="#00000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/control_panel" />

</androidx.constraintlayout.widget.ConstraintLayout>
